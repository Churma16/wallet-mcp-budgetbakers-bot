# ==============================================================================
# STAGE 1: MINIMUM REQUIRED TO RUN THE BOT (CORE PREREQUISITES)
# Fill in these credentials to get the bot running immediately.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1A. BudgetBakers Wallet MCP Server
# ------------------------------------------------------------------------------
# Base URL for Wallet MCP
WALLET_MCP_BASE_URL=https://mcp.wallet.budgetbakers.com
# Personal Access Token from https://web.budgetbakers.com/settings/mcp-server
# Required scopes: records.create, records.read, accounts.read, categories.read, budgets.read
WALLET_MCP_ACCESS_TOKEN=your_wallet_mcp_personal_access_token_here

# ------------------------------------------------------------------------------
# 1B. AI Provider Configuration (NLU & Vision OCR)
# Supported: gemini | openrouter | groq | ollama | openai | custom (default: gemini)
# Multi-Provider Priority Fallback: Comma-separated list in priority order.
# Example: AI_PROVIDER=gemini,openrouter (uses Gemini, automatically fails over to OpenRouter on rate limits/429)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini

# --- Google Gemini (Default & Recommended Native SDK) ---
# Obtain free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Model:
# - gemini-3.5-flash-lite (Recommended: ultra-fast 1-2s response, lightweight, low latency)
# - gemini-3.5-flash / gemini-3.6-flash (Higher reasoning, slightly higher latency 5-10s)
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback models when primary model is busy (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Alternative / Fallback AI Providers (Optional - OpenAI Compatible) ---
# When using AI_PROVIDER=gemini,openrouter, populate OPENROUTER_API_KEY as the fallback safety net.
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# GROQ_API_KEY=gsk_your_groq_key_here
# OPENAI_API_KEY=sk-your_openai_key_here
# AI_API_KEY=your_custom_ai_api_key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-72b-instruct:free
# AI_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------------------
# 1C. Messaging Channels (Choose at least one: WhatsApp or Telegram)
# ------------------------------------------------------------------------------
# Active channels (comma-separated 'whatsapp,telegram'; auto-detects based on provided credentials)
# ENABLED_MESSENGER_CHANNELS=whatsapp,telegram

# --- WhatsApp Configuration (Baileys) ---
# Authorized phone number allowed to interact with the bot (international format without '+' or spaces)
# Example: 6281234567890
ALLOWED_PHONE_NUMBER=6281234567890

# Directory path to store WhatsApp multi-device authentication session credentials
WHATSAPP_SESSION_PATH=./auth_session

# --- Telegram Configuration (grammY) ---
# Obtain Bot Token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram User ID or Username (whitelist security). Obtain ID from @userinfobot or @raw_data_bot
# TELEGRAM_ALLOWED_USER_ID=123456789

# ------------------------------------------------------------------------------
# 1D. Localization & Regional Preferences (Recommended for International Users)
# ------------------------------------------------------------------------------
# The bot ships with Indonesian defaults (id, IDR, Asia/Jakarta).
# If you live outside Indonesia, set these to your own language, currency, and timezone.
# Response language: 'id' (Bahasa Indonesia, default) | 'en' (English)
APP_LANGUAGE=id

# Default currency for fallback and general balance summaries (e.g. 'IDR', 'USD', 'EUR', 'GBP')
DEFAULT_CURRENCY=IDR

# Application timezone for transaction receipts and timestamps (IANA Timezone identifier)
# Examples: 'Asia/Jakarta', 'America/New_York', 'Europe/London', 'Asia/Singapore'
APP_TIMEZONE=Asia/Jakarta


# ==============================================================================
# STAGE 2: OPTIONAL ADD-ON FEATURES
# Configure if you want real-time financial tracking from email notifications.
# ==============================================================================

# ------------------------------------------------------------------------------
# 2A. Email Bank Synchronization (Gmail IMAP IDLE)
# Real-time monitoring for Bank Mandiri (Livin), Bank Jago, GoPay, OVO, DANA, ShopeePay
# ------------------------------------------------------------------------------
# Set to 'true' to enable real-time bank and e-wallet email tracking (default: false)
EMAIL_SYNC_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your_email@gmail.com
# Google App Password (16-character password generated from Google Account > Security > 2-Step Verification > App Passwords)
EMAIL_IMAP_PASSWORD=your_16_char_google_app_password
# Minutes to look back on initial startup (default: 10 minutes) to prevent flood
EMAIL_LOOKBACK_MINUTES=10


# ==============================================================================
# STAGE 3: ADVANCED SYSTEM SAFEGUARDS & ANTI-BAN TUNING
# All settings below have sensible built-in defaults. Change only if needed.
# This stage is dedicated exclusively to system safeguards, throttling,
# and anti-ban configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 3A. WhatsApp Anti-Ban & Rate-Limit Safeguards
# ------------------------------------------------------------------------------
# Maximum reconnection attempts before entering backoff (default: 6)
# WHATSAPP_MAX_RECONNECT_ATTEMPTS=6

# Maximum backoff interval in seconds during reconnection recovery (default: 300)
# WHATSAPP_RECONNECT_MAX_BACKOFF_SECONDS=300

# Outbound message queue throttle interval in milliseconds to prevent rate limiting (default: 1000)
# WHATSAPP_MESSAGE_QUEUE_INTERVAL_MS=1000

# Simulated typing presence cooldown in milliseconds (default: 2500)
# WHATSAPP_TYPING_PRESENCE_COOLDOWN_MS=2500

# ------------------------------------------------------------------------------
# 3B. Telegram Startup Connection Safeguards
# ------------------------------------------------------------------------------
# Maximum startup connection retry attempts to handle transient network issues (default: 5)
# TELEGRAM_MAX_STARTUP_ATTEMPTS=5

# Delay in milliseconds between startup connection retries (default: 2000)
# TELEGRAM_STARTUP_RETRY_DELAY_MS=2000

# ------------------------------------------------------------------------------
# 3C. System Maintenance & Resource Limits
# ------------------------------------------------------------------------------
# Maximum media download size limit in megabytes (protects memory buffers from oversized receipt uploads)
MAX_MEDIA_DOWNLOAD_MB=10

# Daily file logging retention policy in days (logs stored in logs/)
LOG_RETENTION_DAYS=7
