# Google Gemini API Key (obtain from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Models (Primary and Fallback Cascade)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Optional: Gemini request timeout in seconds before auto-fallback to next model (default: 20)
GEMINI_TIMEOUT_SECONDS=20

# BudgetBakers Wallet MCP Server Configuration
# Base URL for Wallet MCP
WALLET_MCP_BASE_URL=https://mcp.wallet.budgetbakers.com
# Personal Access Token from https://web.budgetbakers.com/settings/mcp-server
WALLET_MCP_ACCESS_TOKEN=your_wallet_mcp_personal_access_token_here

# WhatsApp Configuration
# Phone number allowed to interact with the bot (international format without '+' or spaces)
# Example: 6281234567890
ALLOWED_PHONE_NUMBER=6281234567890

# Path to store WhatsApp session credentials
WHATSAPP_SESSION_PATH=./auth_session

# File Logging Retention Policy (number of days to keep daily log files in logs/)
LOG_RETENTION_DAYS=7

# Email Bank Synchronization (Gmail IMAP IDLE) - Optional
# Set to 'true' to enable real-time bank and e-wallet email tracking (default: false)
EMAIL_SYNC_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your_email@gmail.com
# Google App Password (16-character password generated from Google Account > Security > 2-Step Verification > App Passwords)
EMAIL_IMAP_PASSWORD=your_16_char_google_app_password
# Minutes to look back on initial startup (default: 10 minutes) to prevent flood
EMAIL_LOOKBACK_MINUTES=10
